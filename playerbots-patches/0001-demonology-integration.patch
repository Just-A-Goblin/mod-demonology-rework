+        return false;
+    Unit* target = AI_VALUE(Unit*, "current target");
+    if (!target || !target->IsAlive() || !bot->IsValidAttackTarget(target))
+        return false;
+    // Overflow spender: only above the shard reserve so brand/command presses are never starved.
+    return GetSoulShardCount(bot) > ReworkCfg("AiPlayerbot.Demonology.ShardReserve", 2);
+}
 
 bool OutOfSoulstoneTrigger::IsActive() { return GetSoulstoneCount(botAI->GetBot()) == 0; }
 
