+// mod-demonology-rework: fills a Command Pool slot with an Imp legionnaire (the single-target comp).
+bool CastSummonImpLegionnaireAction::isPossible()
+{
+    // The summon is self-cast (unit_caster) but inherited 47193's pet-target flags, so an EXPLICIT
+    // player target (what CanCastSpell/CastSpell(bot) sets) trips SPELL_FAILED_TARGET_IS_PLAYER. We
