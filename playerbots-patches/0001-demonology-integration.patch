+{
+    // Targetless cast => implicit unit_caster, avoiding the player-target rejection. Non-triggered so
+    // the soul-shard reagent + mana are still consumed (the Path-B economy stays intact).
+    bot->CastSpell(static_cast<Unit*>(nullptr), 290002, false);
+    return true;
