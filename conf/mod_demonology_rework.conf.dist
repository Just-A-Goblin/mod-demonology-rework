[worldserver]

###################################################################################################
# mod-demonology-rework
#
# Every design number is tunable here — none survive playtesting (PLAN §10.2).
# Copy to mod_demonology_rework.conf (drop the .dist) to override.
###################################################################################################

# Master switch for the module. (1: on | 0: off)
Demonology.Enable = 1

# --- Soul Harvest (T1): the shard-economy throttle ---
# Proc chance per rank of Soul Harvest (0.04 = 4% -> 4/8/12% at ranks 1/2/3).
Demonology.SoulHarvest.ChancePerRank = 0.04
# Per-player internal cooldown between shard procs, in ms.
Demonology.SoulHarvest.InternalCooldownMs = 1000

# --- Cruel Master (T2): demon crits accelerate Soul Harvest ---
# The crit is simulated in the Soul Harvest proc (no server hook reports a crit result):
# roll the demon's crit chance (Pactbound Fury + BaseCritChance); on a "crit", rank 1
# multiplies the proc chance and rank 2 also multiplies the ICD (values below).
Demonology.CruelMaster.ProcChanceMult = 2.0
Demonology.CruelMaster.IcdMultOnCrit = 0.5
Demonology.CruelMaster.BaseCritChance = 0.05

# --- Per-rank talent multipliers (comma-separated, one value per talent rank) ---
# A short list keeps code defaults for the unspecified ranks. These are the source
# of truth for the numbers in the DESIGN_V2 §4 talent table.
# Demon DAMAGE, additive on 1.0:
#   Vicious Pact (vp): SP-as-attack-power on melee / SP-as-spell-power on spells.
Demonology.ViciousPact.MeleePct = 0.08, 0.16, 0.24
Demonology.ViciousPact.SpellPct = 0.05, 0.10, 0.15
#   Fel Armory (fa): +demon damage while the owner's Fel Armor is up.
Demonology.FelArmory.DamagePct = 0.05, 0.10, 0.15
# Demon HEALTH, additive on 1.0:
#   Fel Conditioning (fc): flat demon health.
Demonology.FelConditioning.HealthPct = 0.05, 0.10, 0.15
#   Cursed Vitality (cv): demon stamina->health part (owner-stamina part is a separate aura).
Demonology.CursedVitality.DemonHealthPct = 0.06, 0.12
# Demon melee HASTE, percent (12 = +12% attack speed):
#   Savage Instincts (si).
Demonology.SavageInstincts.HastePct = 4, 8, 12

# --- Wild Imps ---
Demonology.WildImp.Count = 3
Demonology.WildImp.DurationMs = 20000
# Firebolt SP coefficient for the TEMPORARY Wild Imps (Summon Wild Imps). FLATTEN pass 2026-08-20
# lowered it 0.16 -> 0.11 (paired with a raised flat firebolt base) to flatten the 60->80 scaling.
Demonology.WildImp.SPCoefficient = 0.11
# Firebolt SP coefficient for the PERMANENT Imp legionnaires — DECOUPLED from Wild Imps so the two
# can be tuned independently (the Imp legionnaire is your "caster" legionnaire identity). FLATTEN pass
# lowered it 0.30 -> 0.20 (the imp army was the level-80 single-target outlier). See docs/balance_model.py.
Demonology.ImpLegionnaire.SPCoefficient = 0.20
# Path B: Summon Wild Imps costs this many Soul Shards (fixed). Its 30% base-mana cost and Improved
# Legion's -15/-30% reduction are now DBC (real spell cost + SPELLMOD_COST), tuned in content, not here.
Demonology.WildImp.ShardCost = 1

# --- Greater demons (Infernal / Doomguard): temporary cooldown guardians ---
# How long each fights before despawning, in ms. Cooldown is on the spell (180s).
Demonology.Infernal.DurationMs = 60000
Demonology.Doomguard.DurationMs = 60000
# ROLE DIFFERENTIATION (docs/slot_comparison.py): Doomguard = SINGLE-TARGET nuke, Infernal = AoE/tank.
# Doom Bolt is the Doomguard's ST nuke. FLATTEN pass 2026-08-20 set base 220 / coef 0.55 (was 80/1.00):
# more flat base + lower coef flattens the 60->80 curve and cuts the Doomguard's per-slot dominance.
Demonology.Doomguard.DoomBoltSPCoefficient = 0.55
Demonology.Doomguard.DoomBoltBaseDamage = 220
# Doom Blast is now just a TOKEN cleave — the Doomguard is deliberately ST-focused (its AoE was the
# single biggest AoE source in the kit; Infernal is the AoE demon now).
Demonology.Doomguard.DoomBlastBaseDamage = 0
Demonology.Doomguard.DoomBlastSPCoefficient = 0.10
# Infernal AoE identity: it casts its fire nova (Command Pulse, 8yd source-area) this often, in
# addition to on a Command Demon press — its periodic AoE. (Nova SP coef = InfernalCommandPulse below.)
Demonology.Infernal.PulseCooldownMs = 5000
# Infernal model scale (1.0 = model default, which is very large; lower = smaller).
Demonology.Infernal.Scale = 0.70
# Command slots a greater demon occupies while active (it crowds out legionnaires, so it
# can't stack on a full legion). Summoning one needs this many TOTAL slots and evicts the
# oldest legionnaires to fit. With max 3 slots: Doomguard=3 needs the full Command spine.
Demonology.Infernal.CommandSlots = 2
Demonology.Doomguard.CommandSlots = 3

# --- Demonic Empowerment ---
Demonology.DemonicEmpowerment.Haste = 0.30
Demonology.DemonicEmpowerment.Damage = 0.20
Demonology.DemonicEmpowerment.DurationMs = 12000

# --- Phase 4: Demonic Empowerment spine (all layer onto the buff) ---
# WORST-CASE STACK (single empowered demon, everything maxed, inside a Doombrand window):
#   base damage x1.20 (DemonicEmpowerment.Damage) x +0.15 (Cruelty of the Pit) = x1.35 damage
#   + Vicious Pact/Fel Armory/Pactbound Fury from the demon-damage hook multiply on top
#   + a shield of 30% demon max HP (Shadowflame Legion) + owner leech 20% of that damage
#   + duration 12s +3s (Unholy Vigor 3) +6s (Supreme Empowerment 2) = 21s, ~20% to refresh.
# Doombrand (Phase 5) converts all of that boosted demon damage into stored burst — keep the
# multipliers modest here; ship low, buff later (DESIGN_V2 §10 snowball audit).
# Unholy Vigor (uv): Demonic Empowerment duration bonus per rank (ms).
Demonology.UnholyVigor.DurationMsPerRank = 1000
# Cruelty of the Pit (cotp): empowered demons deal this much extra damage (per rank).
Demonology.CrueltyOfThePit.DamagePct = 0.05, 0.10, 0.15
# Ruinous Empowerment (re): empowered demon damage heals the owner (leech), and the buff has
# a chance to refresh instead of expiring (per rank).
Demonology.RuinousEmpowerment.LeechPct = 0.07, 0.14, 0.20
Demonology.RuinousEmpowerment.NoExpirePct = 0.07, 0.14, 0.20
# Supreme Empowerment (se): duration bonus per rank (ms); also gates Empowerment onto TEMP
# demons (Wild Imps + the greater demon) — without se, only permanent demons are empowered.
Demonology.SupremeEmpowerment.DurationMsPerRank = 3000
# Shadowflame Legion (sl): Empowerment also shields each demon for this fraction of its max HP.
Demonology.ShadowflameLegion.AbsorbPct = 0.15, 0.30

# --- Phase 5: Doombrand (§6) — the Grand Warlock's Design capstone ---
# Fraction of your demons' damage to the branded target that the sigil stores.
# Playtest raised this to 0.50 for detonation feel; the balance pass trimmed it to 0.35 (the
# army, not Doombrand, was the overshoot — so this is a light touch that keeps most of the feel).
Demonology.Doombrand.StorePct = 0.35
# Stored-damage cap = this coefficient * owner spell power (keeps a long window from
# storing unbounded burst). Cut 6.0 -> 5.0 in the balance pass.
Demonology.Doombrand.CapSPCoef = 5.0
Demonology.Doombrand.ShardCost = 1
# Death-detonation: if the branded target DIES, the stored damage is split evenly among
# enemies within this radius of the corpse (an expire-detonation instead hits just the target).
Demonology.Doombrand.AoeRadius = 8.0

# --- Phase 6 talents ---
# Blood Tithe (bt): demons heal you for this fraction of the damage they deal, DOUBLED once
# you command DoubleAtDemons or more demons.
Demonology.BloodTithe.HealPct = 0.04, 0.08
Demonology.BloodTithe.DoubleAtDemons = 3
# Beacon of Ruin (bor): Infernal/Doomguard deal +damage and their summon cooldown is cut by
# this fraction (shipped low per DESIGN_V2 §4 — buff later).
Demonology.BeaconOfRuin.DamagePct = 0.15, 0.30
Demonology.BeaconOfRuin.CdReductionPct = 0.20, 0.40
# Fel Corruption (rc, REDESIGNED): your Corruption ticks count as demon damage for Soul Harvest +
# Doombrand at this per-rank effectiveness. DoombrandStoreMult = half-weight on the brand charge.
Demonology.FelCorruption.RankEffectiveness = 0.33, 0.66, 1.00
Demonology.FelCorruption.DoombrandStoreMult = 0.50
# Improved Wild Imps (iwi): Wild Imp duration bonus per rank (ms); Firebolt 2nd-target chance.
Demonology.ImprovedWildImps.DurationMsPerRank = 5000
Demonology.ImprovedWildImps.SecondTargetPct = 0.10, 0.20
# Wrath of the Legion (wotl): Firebolt chance per rank to spawn an extra Wild Imp; cap/cast.
Demonology.WrathOfTheLegion.SpawnPct = 0.10, 0.20, 0.30
Demonology.WrathOfTheLegion.MaxChainsPerCast = 2
# Each bonus imp spawned by a Firebolt proc drains this % of the owner's BASE mana on spawn (no
# mana, no bonus imp) — a throttle so the proc chain can't snowball for free.
Demonology.WrathOfTheLegion.ManaCostPct = 5.0
# Warded Legion (wl): demon full-spell-resist chance per rank; rank 2 also grants Fear/Charm/Poly immunity.
Demonology.WardedLegion.ResistPct = 0.09, 0.18
# Vital Conduit (vc, REDESIGNED): Life Tap also heals your commanded demons for this fraction of the
# health sacrificed, split among them; overheal allowed (Wild Imps excluded).
Demonology.VitalConduit.HealPct = 0.50, 1.00
# Fel Conduit (fcd): demon attacks proc a Conduit stack (next Shadow Bolt instant + free) per rank.
Demonology.FelConduit.ProcPct = 0.05, 0.10
# Grim Bargain (gb): demon<->owner damage proc synergy — buff amount per rank + proc chance.
Demonology.GrimBargain.DamagePct = 0.06, 0.12
Demonology.GrimBargain.ProcPct = 0.15
# Fel Blood (fb): Lash of Pain damage bonus per rank (the Corruption-refresh half has no number).
Demonology.FelBlood.LashPct = 0.15, 0.30
# Riftwalker (rw): Demonic Circle: Teleport warps your commanded demons to you and grants them
# this much move speed for the duration below.
Demonology.Riftwalker.MoveSpeedPct = 30
Demonology.Riftwalker.DurationMs = 6000
# Fervent Standard (fs): your Demonic Circle is the legion's banner. Within Radius yards of it, you
# and your commanded demons deal +DamagePct damage, and your demons take -MitigationPct damage.
# Offense is kept low (demon half enters the multiplier stack); mitigation (demons only) carries
# the node since it can't compound with the Empowerment spine.
Demonology.FerventStandard.Radius = 20.0
Demonology.FerventStandard.DamagePct = 0.04, 0.08
Demonology.FerventStandard.MitigationPct = 0.05, 0.10
# Anchor Imp pet damage bonus — applies to ALL warlock specs (not a talent). Brings the anchor
# Imp's Firebolt up toward Felhunter tier, since the Imp lacks Succubus/Voidwalker CC/tank utility.
# ONLY affects the anchor Imp PET (entry 416); Wild Imps / Imp legionnaires (WildImp.SPCoefficient)
# are untouched. Tune to taste — verify Imp vs Felhunter anchor DPS in a parse and adjust.
Demonology.ImpAnchor.DamageBonusPct = 0.30

# Per-type legionnaire SIGNATURES — periodic instant ability so each melee demon has a damage
# identity (not a plain-melee clone). SP coefficient (of owner SP, added live) + cooldown (ms).
# Imp keeps Firebolt (WildImp path); Voidwalker stays a pure-melee off-tank (no damage signature).
Demonology.FelguardCleave.SPCoefficient = 0.15
Demonology.FelguardCleave.CooldownMs = 6000
Demonology.FelhunterShadowBite.SPCoefficient = 0.35
Demonology.FelhunterShadowBite.CooldownMs = 6000
Demonology.SuccubusLash.SPCoefficient = 0.25
Demonology.SuccubusLash.CooldownMs = 5000

# --- Command Pool (Phase 1 + Phase 5 Command talents) ---
# Legionnaire slots before talents (pool slots 1..N; the anchor pet is slot 0).
# Design: base 0 — with no talents you command no legionnaires. The Command talent
# spine grants every slot: +1 Expanded Command, +1 Expanded Command II, +1 Legion
# Commander (so a fully-talented warlock commands BaseLegionnaires + 3 = 3).
Demonology.Pool.BaseLegionnaires = 0
# Hard cap the effective slot count never exceeds (base + all Command talents).
Demonology.Pool.MaxLegionnaires = 4
# Soul Shards charged per per-type legionnaire summon (Summon Imp/Felguard/etc.).
Demonology.SummonLegionnaire.ShardCost = 1

# --- Stat inheritance (Phase 6) ---
# Demons scale off the owner instead of a flat clamp. Warlocks are casters, so
# their demons derive power from spell power (SP), not the owner's attack power.
# Demon max health as a fraction of the owner's max health.
Demonology.Inherit.HealthPctOfOwner = 0.60
# Per-swing melee weapon damage as a fraction of owner SP (SP -> melee).
Demonology.Inherit.MeleeDamagePerSP = 0.15

# --- Misc effects ---
Demonology.LegionStandard.HealthPctOfOwner = 0.40
Demonology.Threat.NonAnchorMultiplier = 0.50
Demonology.Beacon.DemonDamagePct = 0.50

# --- Phase 1 talents ---
# Pactbound Fury (pf, T3): demon crit chance per rank. Applied as REAL crits (melee via the
# core melee roll, spell via the demon's base spell crit); crit damage is the core's 2x/1.5x.
Demonology.PactboundFury.CritChancePct = 0.02, 0.04, 0.06
# Demonic Rebirth (dr, T6): chance to instantly resummon a dying legionnaire; shared ICD.
Demonology.DemonicRebirth.ChancePct = 0.50, 1.00
Demonology.DemonicRebirth.IcdMs = 60000
# Bound by Blood (bbb, T9): on demon death, surviving demons gain +damage/+haste for a
# window, and the owner refunds a Soul Shard (Path B economy).
Demonology.BoundByBlood.DamagePct = 0.15, 0.30
Demonology.BoundByBlood.HastePct = 0.25, 0.45
Demonology.BoundByBlood.DurationMs = 10000
# The survivor buff is a strong bloodlust, so it's on a cooldown (ms). The shard
# refund below is NOT gated by this — it fires on every real demon death (Path B).
Demonology.BoundByBlood.IcdMs = 180000
Demonology.BoundByBlood.RefundShard = 1
# Overlord's Presence (op, T8): per commanded demon, buff the OWNER's max health & haste.
Demonology.OverlordsPresence.HealthPct = 0.02, 0.04, 0.06
Demonology.OverlordsPresence.HastePct = 0.015, 0.03, 0.045
# Cursed Vitality (cv, T1) owner half: +owner stamina (the demon-health half is separate).
Demonology.CursedVitality.OwnerStaminaPct = 0.03, 0.06

# --- Command Demon (Phase 3, §5) ---
Demonology.CommandDemon.CooldownMs = 45000
Demonology.CommandDemon.ShardCost = 1
# Dark Command (dc): Command Demon cooldown reduction per rank + a short responder haste.
Demonology.DarkCommand.CdReductionMsPerRank = 5000
Demonology.DarkCommand.HastePct = 0.10
Demonology.DarkCommand.HasteDurationMs = 6000
# Enthralling Presence (Succubus signature): AoE radius around the anchor's target and the
# imperative threat drop (% reduction of owner + pooled-demon threat).
Demonology.EnthrallingPresence.Radius = 8.0
Demonology.EnthrallingPresence.ThreatDropPct = 35
# Voidwalker absorbs as a fraction of max health: owner shield (signature) + self (echo).
Demonology.Voidwalker.OwnerAbsorbPctOfHp = 0.15
Demonology.Voidwalker.SelfAbsorbPctOfHp = 0.10
# Voidwalkers off-tank: threat multiple from all their damage (so aggro sticks to them);
# the Command echo also taunts the anchor's target.
Demonology.Voidwalker.ThreatMultiplier = 4.0
# Echo / greater-demon-response SP scaling (added live at cast).
Demonology.EmpoweredLash.SPCoefficient = 0.30
Demonology.InfernalCommandPulse.SPCoefficient = 0.40

# Log every shard gain to the server log (noisy; for tuning only).
Demonology.Debug.LogShardIncome = 0
